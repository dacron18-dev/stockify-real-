classDiagram
direction TB
class User {
  <<abstract>>
  #string id_
  #string email_
  +role()* string
  +canTrade()* bool
}
class Trader {
  -Account account_
  -Portfolio portfolio_
  +placeBuyOrder(stock, quantity) Order
  +placeSellOrder(stock, quantity) Order
  +viewPortfolio() Portfolio
  +setPriceAlert(stock, price) PriceAlert
}
class Admin
class Account {
  -int accountId
  -Money cashBalance
  +deposit(amount) void
  +deductCash(amount) bool
  +hasSufficientCash(amount) bool
}
class Portfolio {
  -int portfolioId
  +addHolding(holding) void
  +removeHolding(symbol, quantity) void
  +calculateValue(prices) double
}
class Holding {
  -string symbol
  -int quantity
  -double averagePrice
  +increaseQuantity(amount, price) void
  +decreaseQuantity(amount) void
  +calculateValue(currentPrice) double
}
class Order {
  <<abstract>>
  -int orderId
  -OrderType type
  -int quantity
  -double price
  -OrderStatus status
  -time timestamp
  +validate() bool
  +execute(trader)* Transaction
  +cancel() void
}
class BuyOrder
class SellOrder
class Transaction {
  -long transactionId
  -OrderType type
  -int quantity
  -double executionPrice
  +getValue() double
}
class Stock {
  -string symbol
  -string companyName
  -double currentPrice
  -double previousPrice
  +updatePrice(newPrice) void
  +getPrice() double
}
class Market {
  -int marketId
  -string name
  -bool isOpen
  +addStock(stock) void
  +getStock(symbol) Stock
  +updatePrices() void
  +processEvent(event) void
}
class MarketEvent {
  -int eventId
  -string eventType
  -double impactFactor
  +apply(stock) void
}
class Simulation {
  -int simulationId
  -int tickInterval
  -bool running
  +start() void
  +stop() void
  +advanceTick() void
  +generateMarketEvent() MarketEvent
}
class PriceAlert {
  -int alertId
  -double targetPrice
  -bool triggered
  +check(currentPrice) bool
}
class Notification {
  -int notificationId
  -string message
  -bool read
  +markAsRead() void
}
class OrderManager { +placeOrder(trader, type, symbol, qty) Transaction }
class TransactionManager { +createTransaction(userId, tx) Transaction }
class AlertManager { +checkAll() void }
class OrderType { <<enumeration>> BUY SELL }
class OrderStatus { <<enumeration>> PENDING EXECUTED CANCELLED REJECTED }
User <|-- Trader
User <|-- Admin
Order <|-- BuyOrder
Order <|-- SellOrder
Trader "1" --> "1" Account
Trader "1" --> "1" Portfolio
Trader "1" --> "0..*" Order : places
Trader "1" --> "0..*" PriceAlert : sets
Trader "1" --> "0..*" Notification : receives
Portfolio "1" *-- "0..*" Holding
Holding "*" --> "1" Stock
Order "*" --> "1" Stock
Order "1" --> "0..1" Transaction : creates
Order ..> Account : uses
Order ..> Portfolio : updates
Market "1" o-- "1..*" Stock
Simulation "1" --> "1" Market
Simulation "1" --> "0..*" MarketEvent : generates
MarketEvent "*" --> "1..*" Stock : affects
PriceAlert "*" --> "1" Stock
PriceAlert "1" --> "0..*" Notification : triggers
OrderManager ..> Market
OrderManager ..> TransactionManager
OrderManager ..> Order
AlertManager ..> PriceAlert
AlertManager ..> Notification
Simulation ..> AlertManager
Order --> OrderType
Order --> OrderStatus
